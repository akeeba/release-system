{
	"name": "akeeba/ars",
	"description": "Akeeba Release System",
	"minimum-stability": "stable",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"homepage": "https://www.akeeba.com",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=8.1.0 <8.7",
		"ext-json": "*",
		"ext-simplexml": "*"
	},
	"suggest": {
		"ext-fileinfo": "*"
	},
	"config": {
		"platform": {
			"php": "8.1.999"
		}
	},
	"extra": {
		"akcompat": {
			"limit_type": "joomla",
			"limit": ">=5.4.0 <6.3",
			"locations": [
				{
					"file": "component/script.ars.php",
					"type": "variable",
					"marker": "$minimumPhp",
					"value": "PHP_MIN"
				},
				{
					"file": "component/script.ars.php",
					"type": "variable",
					"marker": "$maximumPhp",
					"value": "PHP_MAX"
				},
				{
					"file": "component/script.ars.php",
					"type": "variable",
					"marker": "$minimumJoomla",
					"value": "LIMIT_MIN"
				},
				{
					"file": "component/script.ars.php",
					"type": "variable",
					"marker": "$maximumJoomla",
					"value": "LIMIT_MAX"
				},
				{
					"file": "component/backend/src/Dispatcher/Dispatcher.php",
					"type": "variable",
					"marker": "$minPHPVersion",
					"value": "PHP_MIN"
				}
			]
		}
	}
}

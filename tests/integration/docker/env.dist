# Configuration for the Dockerized end-to-end test stack.
#
# Copy this file to .env and edit as needed, or just run ./run.sh, which creates
# .env from this template automatically on first run. PUID/PGID are always
# overwritten with your current host user by run.sh regardless of what is here.
#
# This template IS committed to git. Do not add local-only settings here; put
# them in .env, which is not.

# ----------------------------------------------------------------------------
# Versions — every component is configurable.
# ----------------------------------------------------------------------------
# JOOMLA_VERSION may be a full version (6.1.2), a branch (6.1) or a major (6).
# For a partial version the latest matching STABLE release is resolved and
# downloaded; drop a package into ../inbox/ to pin an exact build offline.
#
# ARS refuses to install below the floor declared in component/script.ars.php
# (currently 4.3.0), and run.sh enforces the same floor before touching Docker.
JOOMLA_VERSION=6.1

# The versions `run.sh --matrix` iterates over, oldest first. ARS carries
# deliberate Joomla-version branches (createQuery() on 5.1+, UCM handling on
# 5.4+ — see the repo's CLAUDE.md), so a single-version run does not prove those
# branches actually work; the matrix exercises the oldest supported minor on
# each side of them plus the current release.
JOOMLA_MATRIX="5.4 6.0 6.1"

# Docker image tags. PHP 8.4 satisfies the whole matrix above.
PHP_VERSION=8.4
APACHE_VERSION=2.4
MYSQL_VERSION=8.4
MAILPIT_VERSION=v1.21

# ----------------------------------------------------------------------------
# Host ports. Chosen not to collide with the ATS harness (8090/8091/33307/8125)
# or the Admin Tools harness (8080/8081/33306) — you may well want all three
# stacks up at once.
# ----------------------------------------------------------------------------
# The Apache-served site: http://localhost:${HTTP_PORT}
HTTP_PORT=8100
# MySQL, published for the host-side PHPUnit process.
DB_PORT=33308
# Mailpit's REST API and web UI: http://localhost:${MAILPIT_HTTP_PORT}
MAILPIT_HTTP_PORT=8135

# ----------------------------------------------------------------------------
# Database.
# ----------------------------------------------------------------------------
DB_NAME=arse2e
DB_USER=arse2e
DB_PASSWORD=arse2e
DB_ROOT_PASSWORD=root
DB_PREFIX=e2e_

# ----------------------------------------------------------------------------
# Site and the Super User. Every other account is created by SiteProvisioner;
# see tests/integration/src/SiteProvisioner.php for the ACL matrix.
# ----------------------------------------------------------------------------
SITE_NAME="ARS End-to-End"
ADMIN_NAME="Test Super User"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
ADMIN_EMAIL=admin@example.test

# The password given to every provisioned non-admin account.
TEST_USER_PASSWORD=test

# ----------------------------------------------------------------------------
# Outbound mail. Joomla is pointed at Mailpit over real SMTP; the tests read the
# result back over Mailpit's REST API. `mailpit` is the compose service name, so
# this host resolves inside the network only.
# ----------------------------------------------------------------------------
MAIL_FROM=releases@example.test
MAIL_FROM_NAME="ARS Releases"

# ----------------------------------------------------------------------------
# The category directory ARS serves release files from, resolved relative to
# JPATH_ROOT. run.sh creates this directory in the web root before provisioning
# so the fixture provisioner has somewhere to write files.
# ----------------------------------------------------------------------------
ARS_REPOSITORY=arsrepo

# ----------------------------------------------------------------------------
# Host user mapping — set automatically by run.sh, do not rely on these values.
# ----------------------------------------------------------------------------
PUID=1000
PGID=1000
